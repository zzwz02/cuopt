#pragma once

#include_next <cuda/std/tuple>

#if defined(CUOPT_USE_MACA_CCCL)

#include <iterator>

namespace std {

template <typename... Iterators>
struct iterator_traits<::cuda::std::tuple<Iterators...>> {
  using difference_type   = ptrdiff_t;
  using value_type        = ::cuda::std::tuple<typename iterator_traits<Iterators>::value_type...>;
  using pointer           = void;
  using reference         = value_type;
  using iterator_category = random_access_iterator_tag;
};

}  // namespace std

#endif
